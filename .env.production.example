# Contoh .env untuk shared hosting. Salin ke .env di server, lalu isi.
# Jangan pernah commit .env yang sudah berisi kredensial.

APP_NAME="SMP Syekh Yusuf"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://smpsyekhyusuf.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Makassar

# MySQL dari hPanel → Databases → Management
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Tanpa Redis di shared hosting: semuanya lewat tabel database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Email lewat SMTP hosting (hPanel → Emails → Email Accounts)
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@smpsyekhyusuf.id
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@smpsyekhyusuf.id
MAIL_FROM_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_LEVEL=error

VITE_APP_NAME="${APP_NAME}"
